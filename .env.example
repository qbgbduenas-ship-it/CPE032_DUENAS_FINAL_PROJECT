# Copy this file to .env and fill in your own values.
OPENAQ_API_KEY=PASTE_YOUR_OPENAQ_API_KEY_HERE

# MongoDB Atlas connection string. Do not share this file or commit it.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=air_quality_db
MONGODB_COLLECTION=measurements

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=air-quality

# Default coordinates are Metro Manila. Change to your preferred monitoring area.
OPENAQ_LATITUDE=14.5995
OPENAQ_LONGITUDE=120.9842
OPENAQ_RADIUS_METERS=25000
MAX_LOCATIONS_PER_CYCLE=10
PRODUCER_INTERVAL_SECONDS=60

# Spark checkpoint directory (Windows path, update if you use another folder).
SPARK_CHECKPOINT_DIR=file:///D:/AirQualityMonitoring/checkpoints/air-quality
